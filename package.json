{
  "name": "twistroll",
  "version": "1.0.0",
  "description": "Real-time AI fact-checker + cynic for live podcasts — built for TWiST",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:profile": "DIAGNOSTICS=1 NODE_OPTIONS=\"--inspect --max-old-space-size=2048 --require ./scripts/diagnostics-preload.cjs\" tsx src/server/index.ts",
    "build": "tsc",
    "build:frontend": "vite build",
    "start": "node dist/server/index.js",
    "reembed": "tsx scripts/reembed-corpus.ts"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.1.0",
    "@lancedb/lancedb": "^0.27.2",
    "@tavily/core": "^0.7.3",
    "chokidar": "^4.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "author": "@SkunkWorks0x"
}
