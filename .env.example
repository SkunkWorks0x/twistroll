# ─── Port ────────────────────────────────────────────────────
# Single port for HTTP + WebSocket (WS mounts at /ws on the same server).
# PaaS providers (Railway, Fly.io) inject PORT — keep this name.
PORT=3000

# ─── Embedding provider ──────────────────────────────────────
# 'openai' (default — text-embedding-3-small, 1536-dim, matches the committed
# LanceDB corpus) or 'ollama' (embeddinggemma, 768-dim, local-only). Vectors
# aren't interchangeable — switching providers requires re-embedding the
# corpus (npm run reembed).
EMBED_PROVIDER=openai
# Required when EMBED_PROVIDER=openai (the default). Optional when ollama.
OPENAI_API_KEY=

# ─── Ollama (local embeddings + classifier last-resort fallback) ─
# Only consulted when EMBED_PROVIDER=ollama and/or NODE_ENV != 'production'.
# The classifier chain drops Ollama in production (PaaS has no local model).
OLLAMA_BASE_URL=http://localhost:11434
# Model used by the classifier fallback chain when both Anthropic and Groq
# fail. Variable name is historical (predates the Sentinel rename); the model
# string is what matters.
OLLAMA_MODEL_TROLLS=qwen2.5:7b

# ─── Anthropic — required ────────────────────────────────────
# Claim classifier + Docket fact-check verdicts (Claude Haiku 4.5).
ANTHROPIC_API_KEY=
# Optional alias — read as a fallback when ANTHROPIC_API_KEY is unset.
CLOUD_API_KEY=

# ─── Deepgram — required ─────────────────────────────────────
# Nova-3 streaming transcription with diarization.
DEEPGRAM_API_KEY=

# ─── Tavily — recommended ────────────────────────────────────
# Live web retrieval. Without it, Sentinel checks the TWiST archive only —
# most claims about current events will go UNVERIFIABLE.
TAVILY_API_KEY=

# ─── Groq — optional ─────────────────────────────────────────
# Classifier fallback chain (haiku → groq → ollama). Skipped without it.
GROQ_API_KEY=

# ─── Grok (xAI) — optional ───────────────────────────────────
# Grokipedia retrieval is hard-disabled in code today but the key is still
# read as a fallback for any future re-enable.
GROK_API_KEY=

# ─── YouTube ingestion proxy ─────────────────────────────────
# Residential proxy for Railway/cloud YouTube access. Not needed for local Mac.
# When set, threaded through both yt-dlp (--proxy) AND ffmpeg (-http_proxy) —
# the per-segment IP check fails if only yt-dlp is proxied. Provider must
# permit YouTube traffic (Bright Data Web Unlocker, Oxylabs, etc.).
# Format: http://user:pass@host:port  or  http://host:port
YTDLP_PROXY=

# ─── Demo mode ───────────────────────────────────────────────
# When set to 1, /api/session/demo skips the live YouTube attempt and goes
# straight to JSONL replay. Use on Railway when the proxy is unconfigured
# and you want a deterministic demo path.
DEMO_FORCE_REPLAY=

# ─── Tuning ──────────────────────────────────────────────────
# 0.0–1.0 — claim classifier confidence floor below which claims are dropped
# before retrieval. Default 0.7.
CLAIM_CONFIDENCE_THRESHOLD=
